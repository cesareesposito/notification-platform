---
subject: New file uploaded for {{ asset_name }}
---
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>File uploaded</title></head>
<body style="font-family: sans-serif; color: #333;">
  <h1>Hello {{ recipient_name }},</h1>
  <p>{{ actor_name }} uploaded a new file for asset <strong>{{ asset_name }}</strong>.</p>
  <p><strong>File:</strong> {{ file_name }}</p>
  <p><a href="{{ file_url }}">Open file</a></p>
  <p><a href="{{ asset_url }}">Open asset</a></p>
</body>
</html>