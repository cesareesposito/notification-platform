---
subject: Reminder for report #{{ report_id }}
---
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Report reminder</title></head>
<body style="font-family: sans-serif; color: #333;">
  <h1>Hello {{ recipient_name }},</h1>
  <p>This is a reminder that report <strong>#{{ report_id }}</strong> dated {{ report_date }} will start in {{ days_before_start }} days.</p>
  <p><strong>Workflow:</strong> {{ workflow_name }}</p>
  <p><strong>Asset:</strong> {{ asset_name }}</p>
  <p><strong>Form:</strong> {{ form_name }}</p>
  <p><strong>Start date:</strong> {{ date_start }}</p>
</body>
</html>