---
subject: User created {{ target_user_name }}
---
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>User created</title></head>
<body style="font-family: sans-serif; color: #333;">
  <h1>Hello {{ recipient_name }},</h1>
  <p>{{ actor_name }} created your user account.</p>
  <p><strong>Name:</strong> {{ target_user_name }}</p>
  <p><strong>Email:</strong> {{ target_user_email }}</p>
  <p><a href="{{ target_user_url }}">Open profile</a></p>
</body>
</html>