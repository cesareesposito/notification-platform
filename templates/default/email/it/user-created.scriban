---
subject: Utenza creata {{ target_user_name }}
---
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Utenza creata</title></head>
<body style="font-family: sans-serif; color: #333;">
  <h1>Ciao {{ recipient_name }},</h1>
  <p>{{ actor_name }} ha creato la tua utenza.</p>
  <p><strong>Nome:</strong> {{ target_user_name }}</p>
  <p><strong>Email:</strong> {{ target_user_email }}</p>
  <p><a href="{{ target_user_url }}">Apri profilo</a></p>
</body>
</html>